{
  "name": "@slmdevs/tools",
  "version": "0.1.0",
  "description": "Salamandra Devs shared utilities",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./browser": {
      "import": "./dist/browser/index.js",
      "types": "./types/browser/index.d.ts"
    },
    "./node": {
      "import": "./dist/node/index.js",
      "types": "./types/node/index.d.ts"
    },
    "./shared": {
      "import": "./dist/shared/index.js",
      "types": "./types/shared/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "pnpm run build && node --test ./tests/transform.test.mjs",
    "clean": "rm -rf ./dist ./types ./tsconfig.tsbuildinfo ./docs-site",
    "docs": "typedoc",
    "docs:watch": "typedoc --watch",
    "check": "tsc --noEmit",
    "lint": "eslint ./src --ext .ts --fix",
    "format": "prettier --config .prettierrc ./src --write",
    "prepublishOnly": "pnpm run build"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm run format && pnpm run lint"
  },
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SalamandraDevs/tools.git"
  },
  "homepage": "https://github.com/SalamandraDevs/tools#readme",
  "bugs": {
    "url": "https://github.com/SalamandraDevs/tools/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "types"
  ],
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^64.2.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "prettier-plugin-jsdoc": "^1.8.1",
    "simple-git-hooks": "^2.13.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  }
}

{
  "name": "@slmdevs/tools",
  "version": "0.1.0",
  "description": "Salamandra Devs shared utilities",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./types/index.d.ts"
    },
    "./browser": {
      "import": "./dist/browser/index.js",
      "types": "./types/browser/index.d.ts"
    },
    "./node": {
      "import": "./dist/node/index.js",
      "types": "./types/node/index.d.ts"
    },
    "./shared": {
      "import": "./dist/node/index.js",
      "types": "./types/node/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf ./dist ./types ./tsconfig.tsbuildinfo",
    "check": "tsc --noEmit",
    "lint": "eslint ./src --ext .ts --fix",
    "format": "prettier --config .prettierrc ./src --write"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm run format && pnpm run lint"
  },
  "license": "LGPL-3.0-or-later",
  "files": [
    "dist",
    "types"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/eslint": "^9.6.1",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^60.8.3",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  }
}
